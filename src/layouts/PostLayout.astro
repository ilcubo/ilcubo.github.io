---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import { Font } from "astro:assets";
const { frontmatter } = Astro.props
---

<html>
  <head>
    <meta charset="utf-8">
    <title>{frontmatter.title}</title>
    <Font cssVariable="--font-merriweather-sans" preload/>
    <style>
      article {
        margin: auto;
        max-width: 84ch;
        padding: 5px;
      }

      h1 {
        font-family: serif;
      }

      article :global(p) {
        font-family: var(--font-merriweather-sans);
        font-weight: 400;
      }
    </style>
  </head>
  <body>
    <NavBar/>
    <article>
      <h1>{frontmatter.title}</h1>
      <hr/>
      <slot/>
    </article>
  </body>
</html>
